# ATCHOOO runtime configuration
# Copy to .env next to docker-compose.yml (never commit .env)

# Required by current docker-compose.yml; used by the legacy session API.
# This does NOT password-protect the current public /bento/editor (min 6 chars).
ATCHOOO_ADMIN_PASSWORD=

# HMAC secret for the legacy session cookie (min 32 chars)
ATCHOOO_SESSION_SECRET=

# SQLite file path (optional)
# Docker default: /app/data/atchooo-space.sqlite
# Local example: ./data/atchooo-space.sqlite
# ATCHOOO_DB_PATH=/app/data/atchooo-space.sqlite

# Uploaded media directory (optional)
# Docker default: /app/data/media
# ATCHOOO_MEDIA_PATH=/app/data/media
# Optional override when FFmpeg is not available on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Public origin used for metadata and the legacy session API's same-origin checks.
# For the legacy session API, it must match the browser address exactly.
NEXT_PUBLIC_APP_URL=https://space.atchooo.com:2096
# Optional npm mirror for slow NAS networks, e.g. https://registry.npmmirror.com
# NPM_REGISTRY=https://registry.npmjs.org

# Optional: Vaultwarden Link sync. Keep the master password out of this file;
# enter it in the admin-only sync form each time.
# VAULTWARDEN_URL=https://vaultwarden.example.com
# VAULTWARDEN_EMAIL=you@example.com
# BW_CLI_PATH=/opt/bitwarden/node_modules/@bitwarden/cli/build/bw.js

# Releases upgraded from Account Hub still accept the former ACCOUNT_HUB_*
# variables as a temporary compatibility fallback. New deployments should use
# ATCHOOO_* exclusively.

# --- Legacy OpenBento / Supabase (not used by the single-user editor) ---
# NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
