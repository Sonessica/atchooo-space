{
  "name": "atchooo-space",
  "version": "0.7.2",
  "description": "ATCHOOO is a self-hosted personal space and Bento canvas with NAS SQLite persistence, based on OpenBento.",
  "keywords": [
    "bento",
    "bento-me",
    "bento-me-alternative",
    "bento-me-replacement",
    "bento-me-alternative-github",
    "open-source-bento",
    "self-hosted-bento",
    "bento-page",
    "bento-page-builder",
    "link-in-bio",
    "linktree-alternative",
    "github-bento",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "portfolio",
    "personal-page",
    "link-page"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sonessica/atchooo-space"
  },
  "author": "ATCHOOO",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test:canvas": "node --experimental-strip-types --test tests/canvasPlacement.test.mjs",
    "test:sections": "node --experimental-strip-types --test tests/sectionGroups.test.mjs",
    "test:links": "node --experimental-strip-types --test tests/linkImport.test.mjs",
    "test:link-check": "node --experimental-strip-types --test tests/linkAddress.test.mjs",
    "test:vaultwarden": "node --experimental-strip-types --test tests/vaultwardenLinks.test.mjs",
    "start": "next start",
    "lint": "eslint",
    "migrate:images": "node scripts/migrate-embedded-images.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.15.0",
    "next": "16.1.0",
    "next-themes": "^0.4.6",
    "phosphor-react": "^1.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "playwright": "1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
